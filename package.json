{
  "name": "flightlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:offline": "vite build --mode offline",
    "build:pages": "npm run build:offline && python3 scripts/prepare_pages.py",
    "test:offline": "npm run build:offline && node test/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "fft.js": "4.0.4",
    "lucide-react": "0.468.0",
    "papaparse": "5.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "7.3.1",
    "vite-plugin-singlefile": "2.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
